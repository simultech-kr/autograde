# Load inside http {}. Replace domain/certificate paths before applying.
# Both backend listeners are loopback only; publish TCP 20000 and 20010.
limit_req_zone $binary_remote_addr zone=portal_web:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=portal_api:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=portal_connections:10m;

server {
    listen 20010 ssl;
    server_name grade.example.edu;
    ssl_certificate /etc/letsencrypt/live/grade.example.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/grade.example.edu/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    limit_req_status 429;
    limit_conn portal_connections 100;
    # Keep the real Origin on same-origin login form POSTs. The backend's
    # no-referrer policy can make browsers send Origin: null and fail CSRF checks.
    # Replace only this response header; do not rewrite the request's Origin.
    # If adding this block to a site with parent-level add_header directives,
    # repeat those directives here too (nginx add_header inheritance rules).
    proxy_hide_header Referrer-Policy;
    add_header Referrer-Policy "same-origin" always;
    # Optional Next.js phase 0-2 pilot, web server block only. Enable the CSV
    # course allowlist and start loopback Node before uncommenting this line.
    # include /opt/autograde/config/nginx-autograde-next.locations.conf.example;
    # Classroom SSE: stream individual updates immediately. When enabling the
    # Next.js include, its ^~ API location must ALSO disable proxy buffering.
    location ~ ^/instructor/api/v1/courses/[a-z0-9_-]+/classroom/events$ {
        limit_req zone=portal_web burst=20 nodelay;
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_intercept_errors off;
        proxy_read_timeout 45s;
        access_log off;
        error_log /dev/null crit;
    }
    # ZIP body limits apply only to authenticated instructor upload endpoints.
    location ~ ^/courses/[a-z0-9_-]+/instructor/drafts/[A-Za-z0-9_-]+/(uploads/(starter|solution|negative)|grading-template)$ {
        client_max_body_size 6m;
        # Send headers to the application's auth gate before buffering uploads.
        proxy_request_buffering off;
        limit_req zone=portal_web burst=20 nodelay;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
        proxy_read_timeout 30s;
    }
    location ~ ^/courses/[a-z0-9_-]+/instructor/students/import/preview$ {
        client_max_body_size 1100k;
        proxy_request_buffering off;
        limit_req zone=portal_web burst=20 nodelay;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
        proxy_read_timeout 30s;
    }
    # Private PDF exam papers: 10 MiB file limit plus multipart overhead.
    # Do not expose data_root/exam-papers with alias/root/static locations.
    location ~ ^/courses/[a-z0-9_-]+/instructor/exam-papers/ep_[A-Za-z0-9_-]+/upload$ {
        client_max_body_size 11m;
        proxy_request_buffering off;
        limit_req zone=portal_web burst=20 nodelay;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
        proxy_read_timeout 30s;
    }
    # Student-specific materials: single PDF/ZIP 25 MiB; batch ZIP 100 MiB.
    # Never serve data_root/student-materials directly via alias/root/static.
    location ~ ^/courses/[a-z0-9_-]+/instructor/materials/mat_[A-Za-z0-9_-]+/upload$ {
        client_max_body_size 26m;
        proxy_request_buffering off;
        limit_req zone=portal_web burst=20 nodelay;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
        proxy_read_timeout 60s;
    }
    location ~ ^/courses/[a-z0-9_-]+/instructor/materials/mat_[A-Za-z0-9_-]+/upload-batch$ {
        client_max_body_size 101m;
        proxy_request_buffering off;
        limit_req zone=portal_web burst=20 nodelay;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
        proxy_read_timeout 60s;
    }
    # Git-backed CMS files: 25 MiB each, plus multipart overhead.
    # Keep content Git/CAS directories private; all downloads require API auth.
    location ~ ^/courses/[a-z0-9_-]+/instructor/content/cc_[0-9a-f]+/upload$ {
        client_max_body_size 26m;
        proxy_request_buffering off;
        limit_req zone=portal_web burst=20 nodelay;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
        proxy_read_timeout 60s;
    }
    # VS Code VSIX: 64 MiB plus multipart overhead. Keep the extension store
    # private; never expose data_root/ide-extensions through a static location.
    location ~ ^/courses/[a-z0-9_-]+/instructor/extensions$ {
        client_max_body_size 70m;
        proxy_request_buffering off;
        limit_req zone=portal_web burst=20 nodelay;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
    # 20,000 Unicode characters can exceed 64k after form URL encoding.
    # Keep the larger limit scoped to the authenticated explanation editor.
    location ~ ^/courses/[a-z0-9_-]+/instructor/assignments/[A-Za-z0-9_-]+/document$ {
        client_max_body_size 256k;
        proxy_request_buffering off;
        limit_req zone=portal_web burst=20 nodelay;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
        proxy_read_timeout 30s;
    }
    location / {
        limit_req zone=portal_web burst=100 nodelay;
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        # This site issues credentials. Do not put query strings or cookies in logs.
        access_log off;
        proxy_read_timeout 30s;
    }
}

server {
    listen 20000 ssl;
    server_name grade.example.edu;
    ssl_certificate /etc/letsencrypt/live/grade.example.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/grade.example.edu/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 26m;
    limit_req_status 429;
    limit_conn portal_connections 100;
    location / {
        limit_req zone=portal_api burst=200 nodelay;
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
        proxy_read_timeout 60s;
    }
}
