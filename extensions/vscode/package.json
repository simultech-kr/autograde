{
  "name": "autograde-vscode",
  "displayName": "Autograde",
  "description": "C/C++ 실습 과제 수령·다운로드·제출·채점 피드백을 VS Code에서. Linux, macOS, Windows WSL2 수업용 Autograde 확장.",
  "version": "0.5.20",
  "private": true,
  "publisher": "autograde",
  "repository": {
    "type": "git",
    "url": "https://github.com/simultech-kr/autograde.git",
    "directory": "extensions/vscode"
  },
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "과제와 결과 조회는 가능하지만 로컬 파일 검사, 다운로드 및 제출은 비활성화됩니다.",
      "restrictedConfigurations": [
        "autograde.serviceBaseUrl",
        "autograde.allowInsecureHttpPilot"
      ]
    },
    "virtualWorkspaces": false
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:autograde.openLearningHome",
    "onCommand:autograde.studentMaterials",
    "onCommand:autograde.syncContent",
    "onCommand:autograde.openExamMode",
    "onView:autograde.assignments",
    "onCommand:autograde.configureServiceAddress",
    "onCommand:autograde.checkServerConnection",
    "onCommand:autograde.signIn",
    "onCommand:autograde.signOut",
    "onCommand:autograde.redeemAssignmentClaim",
    "onCommand:autograde.refreshAssignments",
    "onCommand:autograde.cloneAssignment",
    "onCommand:autograde.openAssignment",
    "onCommand:autograde.openCourseWorkspace",
    "onCommand:autograde.acceptedAssignmentHistory",
    "onCommand:autograde.submitCurrentCommit",
    "onCommand:autograde.viewLatestResult",
    "onCommand:autograde.viewAssignmentDocument",
    "onCommand:autograde.exportLearning",
    "onCommand:autograde.endLearningSession",
    "onCommand:autograde.manageCourseExtensions",
    "onCommand:autograde.saveLearningCheckpoint",
    "onCommand:autograde.restoreLearningCheckpoint",
    "onCommand:autograde.openServerDownloads",
    "onCommand:autograde.remoteLearning",
    "onCommand:autograde.openStudentPortal"
  ],
  "contributes": {
    "commands": [
      {
        "command": "autograde.syncContent",
        "title": "Autograde: Sync Course Content",
        "shortTitle": "강의자료 업데이트 · 변경분 받기",
        "enablement": "autograde.authenticated",
        "icon": "$(sync)"
      },
      {
        "command": "autograde.manageCourseExtensions",
        "title": "Autograde: Check Course Extension Updates",
        "shortTitle": "수업 확장 설치·업데이트 확인",
        "enablement": "autograde.authenticated",
        "icon": "$(extensions)"
      },
      {
        "command": "autograde.studentMaterials",
        "title": "Autograde: My Learning Materials",
        "shortTitle": "내 배포 자료 · PDF / ZIP 받기",
        "enablement": "autograde.authenticated",
        "icon": "$(files)"
      },
      {
        "command": "autograde.openExamMode",
        "title": "Autograde: Exam Mode",
        "shortTitle": "시험 모드 · 좌석 / Agent 상태",
        "icon": "$(shield)"
      },
      {
        "command": "autograde.openLearningHome",
        "title": "Autograde: Open Learning Home",
        "shortTitle": "학습 홈",
        "icon": "$(home)"
      },
      {
        "command": "autograde.openCourseWorkspace",
        "title": "Autograde: Open Course Workspace",
        "shortTitle": "수업 폴더로 전환 (재연결 필요)",
        "enablement": "autograde.authenticated && isWorkspaceTrusted",
        "icon": "$(window)"
      },
      {
        "command": "autograde.openAssignment",
        "title": "Autograde: Open Existing Assignment",
        "shortTitle": "기존 과제 이어서 열기",
        "enablement": "autograde.authenticated && isWorkspaceTrusted",
        "icon": "$(folder-opened)"
      },
      {
        "command": "autograde.acceptedAssignmentHistory",
        "title": "Autograde: Accepted Assignments and Switch",
        "shortTitle": "수락 이력 / 과제 전환",
        "enablement": "autograde.authenticated",
        "icon": "$(list-selection)"
      },
      {
        "command": "autograde.viewAssignmentDocument",
        "title": "Autograde: View Assignment Description",
        "shortTitle": "과제 설명 보기",
        "enablement": "autograde.authenticated",
        "icon": "$(book)"
      },
      {
        "command": "autograde.downloadDiagnostics",
        "title": "Autograde: Download Diagnostics",
        "shortTitle": "다운로드 진단 · 문의번호",
        "enablement": "autograde.authenticated",
        "icon": "$(bug)"
      },
      {
        "command": "autograde.submissionHistory",
        "title": "Autograde: Submission History and Restore",
        "shortTitle": "제출 기록 / 코드 복원",
        "enablement": "autograde.authenticated",
        "icon": "$(history)"
      },
      {
        "command": "autograde.configureServiceAddress",
        "title": "Autograde: Configure Service Address",
        "shortTitle": "서버 주소 설정",
        "icon": "$(server-environment)"
      },
      {
        "command": "autograde.checkServerConnection",
        "title": "Autograde: Check Server Connection",
        "shortTitle": "서버 연결 확인",
        "icon": "$(pulse)"
      },
      {
        "command": "autograde.signIn",
        "title": "Autograde: Sign In",
        "shortTitle": "로그인",
        "enablement": "!autograde.authenticated",
        "icon": "$(sign-in)"
      },
      {
        "command": "autograde.signOut",
        "title": "Autograde: Sign Out",
        "shortTitle": "로그아웃",
        "enablement": "autograde.authenticated",
        "icon": "$(sign-out)"
      },
      {
        "command": "autograde.redeemAssignmentClaim",
        "title": "Autograde: Enter Assignment Claim Code and Download",
        "shortTitle": "수령 코드 입력 및 다운로드",
        "enablement": "isWorkspaceTrusted",
        "icon": "$(key)"
      },
      {
        "command": "autograde.refreshAssignments",
        "title": "Autograde: Refresh Assignments",
        "shortTitle": "과제 새로고침",
        "enablement": "autograde.authenticated",
        "icon": "$(refresh)"
      },
      {
        "command": "autograde.cloneAssignment",
        "title": "Autograde: Download or Clone Assignment",
        "shortTitle": "과제 파일 다운로드",
        "enablement": "autograde.authenticated && isWorkspaceTrusted",
        "icon": "$(cloud-download)"
      },
      {
        "command": "autograde.submitCurrentCommit",
        "title": "Autograde: Submit Assignment",
        "shortTitle": "과제 제출",
        "enablement": "autograde.authenticated && isWorkspaceTrusted",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "autograde.viewLatestResult",
        "title": "Autograde: View Latest Result",
        "shortTitle": "채점 결과 보기",
        "enablement": "autograde.authenticated",
        "icon": "$(output)"
      },
      {
        "command": "autograde.exportLearning",
        "title": "Autograde: Export My Learning",
        "shortTitle": "내 학습내용 내보내기 · 폴더 / ZIP",
        "enablement": "isWorkspaceTrusted",
        "icon": "$(export)"
      },
      {
        "command": "autograde.endLearningSession",
        "title": "Autograde: End Shared Learning Session",
        "shortTitle": "공용 실습 종료 · 임시 파일 정리",
        "enablement": "autograde.sharedSession",
        "icon": "$(sign-out)"
      },
      {
        "command": "autograde.saveLearningCheckpoint",
        "title": "Autograde: Save Current Learning Work",
        "shortTitle": "지금 작업 서버 저장 · 공식 제출 아님",
        "enablement": "autograde.authenticated && isWorkspaceTrusted"
      },
      {
        "command": "autograde.restoreLearningCheckpoint",
        "title": "Autograde: Restore Server Learning Work",
        "shortTitle": "서버 작업 저장본 · 새 폴더로 복원",
        "enablement": "autograde.authenticated && isWorkspaceTrusted"
      },
      {
        "command": "autograde.openServerDownloads",
        "title": "Autograde: Server Assignments and Materials",
        "shortTitle": "서버 과제·자료 다운로드",
        "icon": "$(cloud-download)"
      },
      {
        "command": "autograde.remoteLearning",
        "title": "Autograde: Remote C/C++ Learning Space",
        "shortTitle": "원격 C/C++/Python 실습 · 실행",
        "enablement": "autograde.authenticated && isWorkspaceTrusted",
        "icon": "$(remote)"
      },
      {
        "command": "autograde.openStudentPortal",
        "title": "Autograde: Open Student Portal",
        "shortTitle": "학생 포털 · 내 수업",
        "icon": "$(globe)"
      }
    ],
    "configuration": {
      "title": "Autograde",
      "properties": {
        "autograde.examControlBaseUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "별도 시험 관리 서버의 HTTPS origin(주소·포트)입니다. **사용자 설정 값만 읽으며 작업 영역 설정은 무시합니다.** HTTP는 loopback만 허용합니다. 시험 토큰은 저장되지 않으며 Autograde 토큰을 이 주소로 보내지 않습니다."
        },
        "autograde.serviceBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:20000",
          "scope": "machine",
          "markdownDescription": "Autograde 서비스의 기본 URL입니다. 학습 홈의 **서버 설정**에서 IP와 선택적인 port를 직접 입력할 수 있습니다. 주소만 이 컴퓨터에 저장되며 로그인 token은 저장되지 않습니다. 기본적으로 로컬 개발 주소가 아니면 HTTPS만 허용됩니다."
        },
        "autograde.allowInsecureHttpPilot": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "**위험:** 암호화되지 않은 HTTP 접속을 RFC1918 사설 IPv4 주소에 한해 허용합니다. 신뢰된 같은 LAN에서 짧게 진행하는 파일럿에서만 켜고, 인터넷 공개나 공유 네트워크에서는 사용하지 마세요."
        },
        "autograde.studentPortalBaseUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "교수자가 안내한 학생 웹의 HTTPS 주소와 포트입니다. 채점 API 주소에서 포트를 추정하지 않습니다. 사용자 설정만 읽고 작업 영역 설정은 무시합니다. 브라우저 로그인은 IDE와 별개이며 토큰·학번은 URL로 보내지 않습니다."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autograde",
          "title": "Autograde",
          "icon": "media/autograde.svg"
        }
      ]
    },
    "views": {
      "autograde": [
        {
          "id": "autograde.assignments",
          "name": "내가 수락한 실습"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "autograde.assignments",
        "when": "!autograde.authenticated",
        "contents": "학생 포털에서 새 수령 코드를 받아 연결하세요. 웹 주소와 채점 서버 주소는 교수자의 안내를 따릅니다. 일반 VS Code의 기존 과제 파일은 이어서 사용할 수 있습니다. 공용 Autograde IDE는 종료 후 파일이 정리되며 서버 저장본을 복원할 수 있습니다.\n[학습 홈](command:autograde.openLearningHome)\n[학생 포털 · 내 수업](command:autograde.openStudentPortal)\n[서버 과제·자료 다운로드](command:autograde.openServerDownloads)\n[서버 주소 설정](command:autograde.configureServiceAddress)\n[서버 연결 확인](command:autograde.checkServerConnection)\n[수령 코드 입력 및 다운로드](command:autograde.redeemAssignmentClaim)"
      },
      {
        "view": "autograde.assignments",
        "when": "autograde.authenticated",
        "contents": "현재 인증에서 표시할 수락 과제가 없습니다. 수락 이력에서 과제를 확인하고 해당 과제의 새 수령 코드로 연결하세요.\n[학습 홈](command:autograde.openLearningHome)\n[학생 포털 · 내 수업](command:autograde.openStudentPortal)\n[서버 과제·자료 다운로드](command:autograde.openServerDownloads)\n[수락 이력 / 과제 전환](command:autograde.acceptedAssignmentHistory)\n[서버 주소 설정](command:autograde.configureServiceAddress)\n[서버 연결 확인](command:autograde.checkServerConnection)\n[수령 코드 입력 및 다운로드](command:autograde.redeemAssignmentClaim)\n[과제 새로고침](command:autograde.refreshAssignments)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "autograde.openServerDownloads",
          "when": "view == autograde.assignments",
          "group": "navigation@1"
        },
        {
          "command": "autograde.syncContent",
          "when": "view == autograde.assignments && autograde.authenticated",
          "group": "1_assignment@6"
        },
        {
          "command": "autograde.studentMaterials",
          "when": "view == autograde.assignments && autograde.authenticated",
          "group": "1_assignment@5"
        },
        {
          "command": "autograde.openExamMode",
          "when": "view == autograde.assignments",
          "group": "2_settings@5"
        },
        {
          "command": "autograde.openLearningHome",
          "when": "view == autograde.assignments",
          "group": "2_settings@4"
        },
        {
          "command": "autograde.openCourseWorkspace",
          "when": "view == autograde.assignments && autograde.authenticated && isWorkspaceTrusted",
          "group": "2_settings@3"
        },
        {
          "command": "autograde.openAssignment",
          "when": "view == autograde.assignments && autograde.authenticated && isWorkspaceTrusted",
          "group": "1_assignment@3"
        },
        {
          "command": "autograde.acceptedAssignmentHistory",
          "when": "view == autograde.assignments && autograde.authenticated",
          "group": "1_assignment@4"
        },
        {
          "command": "autograde.configureServiceAddress",
          "when": "view == autograde.assignments",
          "group": "2_settings@0"
        },
        {
          "command": "autograde.checkServerConnection",
          "when": "view == autograde.assignments",
          "group": "2_settings@1"
        },
        {
          "command": "autograde.redeemAssignmentClaim",
          "when": "view == autograde.assignments && isWorkspaceTrusted",
          "group": "1_assignment@0"
        },
        {
          "command": "autograde.signOut",
          "when": "view == autograde.assignments && autograde.authenticated",
          "group": "navigation@3"
        },
        {
          "command": "autograde.refreshAssignments",
          "when": "view == autograde.assignments && autograde.authenticated",
          "group": "1_assignment@8"
        },
        {
          "command": "autograde.cloneAssignment",
          "when": "view == autograde.assignments && autograde.authenticated && autograde.hasDownloadableAssignments && isWorkspaceTrusted",
          "group": "1_assignment@1"
        },
        {
          "command": "autograde.submitCurrentCommit",
          "when": "view == autograde.assignments && autograde.authenticated && isWorkspaceTrusted",
          "group": "1_assignment@2"
        },
        {
          "command": "autograde.downloadDiagnostics",
          "when": "view == autograde.assignments && autograde.authenticated",
          "group": "2_settings@2"
        },
        {
          "command": "autograde.openStudentPortal",
          "when": "view == autograde.assignments",
          "group": "2_settings@0"
        }
      ],
      "view/item/context": [
        {
          "command": "autograde.openAssignment",
          "when": "view == autograde.assignments && autograde.authenticated && (viewItem == autograde.assignment || viewItem == autograde.assignmentWithSubmission) && isWorkspaceTrusted",
          "group": "1_assignment@1"
        },
        {
          "command": "autograde.viewAssignmentDocument",
          "when": "view == autograde.assignments && autograde.authenticated && (viewItem == autograde.assignment || viewItem == autograde.assignmentWithSubmission)",
          "group": "1_assignment@3"
        },
        {
          "command": "autograde.cloneAssignment",
          "when": "view == autograde.assignments && autograde.authenticated && (viewItem == autograde.assignment || viewItem == autograde.assignmentWithSubmission) && isWorkspaceTrusted",
          "group": "1_assignment@0"
        },
        {
          "command": "autograde.submitCurrentCommit",
          "when": "view == autograde.assignments && autograde.authenticated && (viewItem == autograde.assignment || viewItem == autograde.assignmentWithSubmission) && isWorkspaceTrusted",
          "group": "inline@1"
        },
        {
          "command": "autograde.viewLatestResult",
          "when": "view == autograde.assignments && autograde.authenticated && viewItem == autograde.assignmentWithSubmission",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "tsc -p ./",
    "test": "npm run clean && npm run compile && node --test out/test/*.test.js",
    "package:vsix": "vsce package --dependencies --baseContentUrl https://github.com/simultech-kr/autograde/blob/main/extensions/vscode/ --baseImagesUrl https://github.com/simultech-kr/autograde/raw/main/extensions/vscode/",
    "vscode:prepublish": "npm run clean && npm run compile"
  },
  "dependencies": {
    "semver": "7.8.5",
    "tar-stream": "3.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/tar-stream": "3.1.4",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.7.2"
  }
}
