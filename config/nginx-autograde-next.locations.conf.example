# OPTIONAL: include inside the existing 20010 server {}, never the 20000 API.
# Keep legacy /courses/* and /instructor handlers untouched.
# Requires portal_web limit_req zone from nginx-autograde-portal.conf.example.
# Default closed API policy is controlled by the pilot CSV, not these links.
# Nginx upstream error messages can include student search terms in request URIs.
# Suppress raw per-request error logs here; use health checks and sanitized
# application request IDs for diagnostics, or deploy a reviewed redacting sink.
location = /app {
    limit_req zone=portal_web burst=100 nodelay;
    proxy_pass http://127.0.0.1:18082;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Node serves a public shell and must not receive Python credentials.
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_buffering off;
    proxy_intercept_errors on;
    error_page 502 503 504 =503 @autograde_next_unavailable;
    proxy_read_timeout 15s;
    access_log off;
    error_log /dev/null crit;
}
location ^~ /app/ {
    limit_req zone=portal_web burst=100 nodelay;
    proxy_pass http://127.0.0.1:18082;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_buffering off;
    proxy_intercept_errors on;
    error_page 502 503 504 =503 @autograde_next_unavailable;
    proxy_read_timeout 15s;
    access_log off;
    error_log /dev/null crit;
}
location ^~ /instructor/api/v1/ {
    # Phase 0-2 is GET only; do not enlarge all API body limits for future ZIPs.
    client_max_body_size 64k;
    proxy_request_buffering off;
    limit_req zone=portal_web burst=100 nodelay;
    proxy_pass http://127.0.0.1:18081;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Preserve Authorization, Cookie, original Origin and backend JSON errors.
    proxy_intercept_errors off;
    proxy_read_timeout 30s;
    access_log off;
    error_log /dev/null crit;
}
location @autograde_next_unavailable {
    error_log /dev/null crit;
    default_type text/html;
    charset utf-8;
    add_header Cache-Control "no-store" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    return 503 '<!doctype html><html lang="ko"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Autograde 화면 연결 지연</title><h1>새 화면에 연결할 수 없습니다</h1><p>학생 제출 API는 별도로 동작합니다. 기존 교수자 화면을 이용해 주세요.</p><a href="/instructor">기존 교수자 화면 열기</a></html>';
}
# Phase 3 only: before enabling /instructor/api/v1/.../uploads or CSV aliases,
# use narrower locations with BOTH scoped body limits AND
# proxy_request_buffering off. A ^~ prefix skips regex upload locations: replace
# this prefix or add a longer explicit match; verify the selected location with
# actual HTTPS unauthenticated/slow upload tests. Never enable size limits alone.
