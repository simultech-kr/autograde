# PRODUCTION DESIGN REFERENCE ONLY.
# The local CSV pilot does not load this file or require environment variables.
# One future deployed service instance is scoped to one course.
AUTOGRADE_COURSE_KEY=cse101-2026f
AUTOGRADE_DATA_ROOT=/var/lib/autograde-cse101
AUTOGRADE_PUBLIC_BASE_URL=https://grade.example.edu
# Use the same local runtime/context for assignment add/ready, manual process,
# and serve. Runner images must already exist under their exact digest.
AUTOGRADE_GRADING_RUNTIME=docker
AUTOGRADE_RUNNER_IMAGE_INSPECT_TIMEOUT=15

# Direct-bundle delivery and submission need no GitHub configuration. Enable
# these together only for the optional private-repository collection mode. The
# PEM must be a regular mode-0600 file and the App must grant only Contents:read.
# AUTOGRADE_GITHUB_APP_ID=123456
# AUTOGRADE_GITHUB_APP_INSTALLATION_ID=78901234
# AUTOGRADE_GITHUB_APP_PRIVATE_KEY=/etc/autograde/cse101-github-app.pem
# AUTOGRADE_GITHUB_API_BASE_URL=https://api.github.com
# AUTOGRADE_GIT_ASKPASS_PATH=/opt/autograde/.venv/bin/autograde-git-askpass

# GitHub OAuth is not required. Student authentication uses one-time activation
# codes issued by the operator CLI. These optional variables only enable the
# legacy compatibility login path and must be configured together.
# AUTOGRADE_GITHUB_CLIENT_ID=replace-with-oauth-client-id
# AUTOGRADE_GITHUB_CLIENT_SECRET=replace-with-oauth-client-secret
